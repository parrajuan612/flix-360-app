<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F171E"
    android:focusableInTouchMode="true"
    android:focusable="true">

    <!-- Selectores -->
    <LinearLayout
        android:id="@+id/selectors"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocal"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Local"
            app:boxStrokeColor="#16D98C">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textColorHint="#AAAAAA"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategory"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Categoría (opcional)"
            android:layout_marginTop="8dp"
            app:boxStrokeColor="#16D98C">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textColorHint="#AAAAAA"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProduct"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Producto (opcional)"
            android:layout_marginTop="8dp"
            app:boxStrokeColor="#16D98C">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textColorHint="#AAAAAA"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Contadores -->
    <LinearLayout
        android:id="@+id/counters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/selectors"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtExpected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Esperados: 0"
            android:textColor="#8FA1AE"
            android:textSize="18sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/txtRead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Leídos: 0"
            android:textColor="#16D98C"
            android:textSize="18sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/txtDiff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Diferencia: 0"
            android:textColor="#F44336"
            android:textSize="18sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#0E151B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnBottomLocales"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏪" android:textSize="18sp" android:textColor="#16D98C"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCALES" android:textColor="#8FA1AE" android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnNavCapture"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="▢"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#04251A"
            android:background="@drawable/bg_scan_button"/>

        <LinearLayout
            android:id="@+id/btnNavAudit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✅" android:textSize="18sp" android:textColor="#8FA1AE"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUDITORÍA" android:textColor="#8FA1AE" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
