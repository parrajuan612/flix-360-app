<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F171E"
    android:focusableInTouchMode="true"
    android:focusable="true"
    tools:context=".ui.scanner.ScannerActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAPTURA"
            android:textColor="#16D98C"
            android:textSize="12sp"
            android:textAllCaps="true"/>

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Asignación"
            android:textColor="#EAF6F2"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Selectores de Local y Producto -->
    <LinearLayout
        android:id="@+id/selectors"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocal"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Local"
            app:boxStrokeColor="#16D98C">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textColorHint="#AAAAAA"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilProduct"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Producto"
            android:layout_marginTop="8dp"
            app:boxStrokeColor="#16D98C">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdownProduct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textColorHint="#AAAAAA"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Control de Rango -->
    <LinearLayout
        android:id="@+id/powerControl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/selectors"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajuste de alcance"
            android:textColor="#8FA1AE"
            android:textSize="12sp"/>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderPower"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="5"
            android:valueTo="30"
            android:stepSize="1"
            app:tickVisible="false"/>

        <TextView
            android:id="@+id/txtPowerValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rango: Largo (Hasta 10 metros)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Feedback y contador -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFeedback"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#101820"
        app:cardCornerRadius="24dp"
        app:strokeColor="#16D98C"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/powerControl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/txtScanState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LISTO"
                    android:textColor="#16D98C"
                    android:background="@drawable/bg_chip_green"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"/>
                <TextView
                    android:id="@+id/txtRssi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  RSSI: -40  "
                    android:textColor="#8FA1AE"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtTagCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="54sp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Lista de lecturas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvScannedTags"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/cardFeedback"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnAssign"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAssign"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="ASIGNAR 0 PRODUCTOS"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:textColor="#04251A"
        app:cornerRadius="24dp"
        app:backgroundTint="#16D98C"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"/>

    <!-- Bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#0E151B"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnBottomLocales"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏪" android:textSize="18sp" android:textColor="#16D98C"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOCALES" android:textColor="#8FA1AE" android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnNavCapture"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="▢"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#04251A"
            android:background="@drawable/bg_scan_button"/>

        <LinearLayout
            android:id="@+id/btnNavAudit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦" android:textSize="18sp" android:textColor="#8FA1AE"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AUDITORÍA" android:textColor="#8FA1AE" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>