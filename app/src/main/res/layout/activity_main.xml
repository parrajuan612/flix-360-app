<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F171E"
    tools:context=".MainActivity">

    <!-- Header brand -->
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_avatar_circle"
        android:contentDescription="avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/titleBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FLIX 360"
        android:textColor="#E6F7F1"
        android:textStyle="bold"
        android:textSize="22sp"
        app:layout_constraintStart_toEndOf="@id/avatar"
        app:layout_constraintTop_toTopOf="@id/avatar"
        android:layout_marginStart="12dp"/>

    <TextView
        android:id="@+id/subBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="INVENTORY"
        android:textColor="#6D7A85"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/titleBrand"
        app:layout_constraintTop_toBottomOf="@id/titleBrand"
        android:layout_marginTop="2dp"/>

    <!-- Admin badge -->
    <TextView
        android:id="@+id/badgeAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:text="  ●  ADMIN ACCESS  "
        android:textColor="#16D98C"
        android:textSize="12sp"
        android:letterSpacing="0.05"
        app:layout_constraintStart_toStartOf="@+id/titleBrand"
        app:layout_constraintTop_toBottomOf="@id/subBrand"
        android:layout_marginTop="24dp"/>

    <!-- Headline -->
    <TextView
        android:id="@+id/headline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Acceder al sistema"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/badgeAdmin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Panel operativo de inventario multi-local"
        android:textColor="#7C8A97"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/headline"
        app:layout_constraintStart_toStartOf="@id/headline"
        app:layout_constraintEnd_toEndOf="@id/headline"
        android:layout_marginTop="8dp"/>

    <!-- Inputs -->
    <EditText
        android:id="@+id/inputUser"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_input"
        android:hint="USER"
        android:textColorHint="#6F7C88"
        android:textColor="#FFFFFF"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:inputType="textEmailAddress"/>

    <EditText
        android:id="@+id/inputPassword"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_input"
        android:hint="PASSWORD"
        android:textColorHint="#6F7C88"
        android:textColor="#FFFFFF"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/inputUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:inputType="textPassword"/>

    <TextView
        android:id="@+id/forgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Olvidé mi contraseña"
        android:textColor="#8FA1AE"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/inputPassword"
        app:layout_constraintStart_toStartOf="@id/inputPassword"
        android:layout_marginTop="20dp"/>

    <!-- Primary Button -->
    <Button
        android:id="@+id/btnSend"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_button_primary"
        android:text="ENVIAR   →"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#021A12"
        app:layout_constraintTop_toBottomOf="@id/forgot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="64dp"
        android:layout_marginTop="24dp"/>

    <!-- Footer brand -->
    <TextView
        android:id="@+id/footerBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FLIX 360"
        android:textColor="#16D98C"
        android:textStyle="bold"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/btnSend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="36dp"/>

    <TextView
        android:id="@+id/footerVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.1"
        android:textColor="#71808B"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/footerBrand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/guest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Continuar como invitado"
        android:textColor="#8FA1AE"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/footerVersion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>